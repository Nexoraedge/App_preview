{
  "expo": {
    "name": "Adityam Niramayaa",
    "slug": "adityam-niramayaa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-an.png",
    "scheme": "adityam",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-an.png",
      "resizeMode": "contain",
      "backgroundColor": "#172554"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adityam.niramayaa"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#172554",
      "translucent": false
    },
    "androidNavigationBar": {
      "visible": "always",
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-an.png",
        "backgroundColor": "#172554"
      },
      "package": "com.adityam.niramayaa"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Adityam Niramayaa to access your camera to scan pharmacy QR codes and capture bill receipts."
        }
      ],
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
